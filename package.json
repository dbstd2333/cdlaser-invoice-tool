{
  "name": "cdlaser-invoice-tool",
  "version": "1.0.0",
  "description": "成都莱盛发票库存管理工具 - 单机 Electron 桌面应用",
  "main": "./out/main/index.js",
  "author": "CDLaser",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win --x64",
    "build:mac": "electron-vite build && electron-builder --mac --x64",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^2.0.0",
    "antd": "^6.0.0",
    "better-sqlite3": "13.0.1",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "dayjs": "^1.11.13",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.2",
    "electron-log": "5.4.4",
    "jszip": "3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "uuid": "14.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.4.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@swc/core": "^1.15.46",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/uuid": "11.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "10.0.4",
    "drizzle-kit": "0.31.10",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "oxlint": "1.31.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.cdlaser.invoice-tool",
    "productName": "成都莱盛发票库存管理工具",
    "directories": {
      "output": "release"
    },
    "publish": null,
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.bin",
      "!**/node_modules/*/{test,__tests__,tests}/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "成都莱盛发票库存管理工具-${version}-setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "成都莱盛发票库存管理工具"
    },
    "extraResources": [
      {
        "from": "resources/templates",
        "to": "templates"
      }
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "@swc/core",
      "esbuild"
    ]
  }
}
